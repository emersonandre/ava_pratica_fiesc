# =============================================================================
# Copie para backend/.env e preencha. Nunca versione o .env.
# =============================================================================

# --- Banco de dados -----------------------------------------------------------
# A porta 5433 evita conflito com um PostgreSQL ja instalado na maquina.
POSTGRES_USER=prescritiva
POSTGRES_PASSWORD=prescritiva
POSTGRES_DB=prescritiva
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://prescritiva:prescritiva@localhost:5433/prescritiva

# --- LLM ----------------------------------------------------------------------
# OpenAI e DeepSeek falam o mesmo protocolo: muda apenas base_url e model.
#   openai   -> LLM_BASE_URL vazio
#   deepseek -> LLM_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=16000
# Modelo de raciocinio leva ~35s tipicos, com picos acima de 60s.
LLM_TIMEOUT_SECONDS=120
# Teto do conjunto de tentativas: falha em tempo util em vez de esperar sem fim.
LLM_BUDGET_SECONDS=180

# Modelo com visao, usado apenas no OCR offline dos documentos (SPEC-FEAT-006).
# Precisa ser um modelo que aceite imagem; o pipeline falha cedo se nao for.
VISION_PROVIDER=deepseek
VISION_API_KEY=
VISION_MODEL=deepseek-v4-flash

# --- Embeddings (locais, ONNX, sem GPU) ---------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Similaridade -------------------------------------------------------------
SIMILARITY_K=50
# Concordancia minima da vizinhanca (0 a 1) para o sistema emitir diagnostico.
# Abaixo disso ele se abstem e entrega apenas os eventos similares.
# Calibrado em backend/docs/analise/similaridade.md.
SIMILARITY_CONFIDENCE_MIN=0.70

# --- API ----------------------------------------------------------------------
# 8001 pelo mesmo motivo da 5433 no PostgreSQL: nao colidir com outro servico ja
# rodando na maquina. A 8000 e a porta padrao de facto de qualquer app Python.
API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Autenticacao externa (JWT) ----------------------------------------------
# Protege POST /api/v1/predict e POST /api/v1/upload_doc, consumidos por
# sistemas da planta. O cliente troca client_id/client_secret por um token em
# POST /api/v1/auth/token e envia `Authorization: Bearer <token>`.
# Gere os valores com: python -m app.scripts.gen_secrets
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_CLIENT_ID=
API_CLIENT_SECRET=

# --- Autenticacao interna (frontend) -----------------------------------------
# Chave trocada entre o proxy do frontend e a API, dentro da rede do compose.
# Vai no cabecalho X-Internal-Key e nunca chega ao navegador.
# O mesmo valor precisa estar em frontend/.env.
INTERNAL_API_KEY=

# --- Caminhos -----------------------------------------------------------------
DATA_CSV=dados/banner.csv
DOCS_DIR=arquivos
ARTIFACTS_DIR=backend/artifacts
