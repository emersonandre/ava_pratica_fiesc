# Copie para frontend/.env

# URL da API vista pelo NAVEGADOR do usuario (nao pelo container).
VITE_API_URL=http://localhost:8001

# Upstream visto pelo proxy DENTRO da rede do compose.
API_UPSTREAM=http://prescritiva-api:8000

# Chave de comunicacao interna com o backend. Deve ser identica a
# INTERNAL_API_KEY do backend/.env. O proxy a injeta no cabecalho
# X-Internal-Key; ela nunca e exposta ao navegador.
INTERNAL_API_KEY=

WEB_PORT=5173
